            </span><span class="s2">"count"</span><span class="p">:</span><span class="mi">1709</span><span class="p">,</span><span class="w">
            </span><span class="s2">"bid"</span><span class="p">:</span><span class="mf">0.004651</span><span class="p">,</span><span class="w">
            </span><span class="s2">"bidSize"</span><span class="p">:</span><span class="mf">54300.341</span><span class="p">,</span><span class="w">
            </span><span class="s2">"ask"</span><span class="p">:</span><span class="mf">0.004679</span><span class="p">,</span><span class="w">
