    </span><span class="s2">"ch"</span><span class="p">:</span><span class="s2">"market.btcusdt.trade.detail"</span><span class="p">,</span><span class="w">
    </span><span class="s2">"ts"</span><span class="p">:</span><span class="mi">1630994963175</span><span class="p">,</span><span class="w">
    </span><span class="s2">"tick"</span><span class="p">:{</span><span class="w">
        </span><span class="s2">"id"</span><span class="p">:</span><span class="mi">137005445109</span><span class="p">,</span><span class="w">
        </span><span class="s2">"ts"</span><span class="p">:</span><span class="mi">1630994963173</span><span class="p">,</span><span class="w">
        </span><span class="s2">"data"</span><span class="p">:[</span><span class="w">
            </span><span class="p">{</span><span class="w">
                </span><span class="s2">"id"</span><span class="p">:</span><span class="mi">137005445109359286410323766</span><span class="p">,</span><span class="w">
                </span><span class="s2">"ts"</span><span class="p">:</span><span class="mi">1630994963173</span><span class="p">,</span><span class="w">
                </span><span class="s2">"tradeId"</span><span class="p">:</span><span class="mi">102523573486</span><span class="p">,</span><span class="w">
                </span><span class="s2">"amount"</span><span class="p">:</span><span class="mf">0.006754</span><span class="p">,</span><span class="w">
                </span><span class="s2">"price"</span><span class="p">:</span><span class="mf">52648.62</span><span class="p">,</span><span class="w">
                </span><span class="s2">"direction"</span><span class="p">:</span><span class="s2">"buy"</span><span class="w">
            </span><span class="p">}</span><span class="w">
        </span><span class="p">]</span><span class="w">
    </span><span class="p">}</span><span class="w">
</span><span class="p">}</span><span class="w">
</span></code></pre><h3 id='update-content-6'>Update Content</h3>
<table><thead>
<tr>
<th>Field</th>
<th>Data Type</th>
<th>Description</th>
</tr>
</thead><tbody>
