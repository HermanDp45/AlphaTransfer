            </span><span class="s2">"open"</span><span class="p">:</span><span class="mf">12.795626</span><span class="p">,</span><span class="w">
            </span><span class="s2">"high"</span><span class="p">:</span><span class="mf">12.918053</span><span class="p">,</span><span class="w">
            </span><span class="s2">"low"</span><span class="p">:</span><span class="mf">12.568926</span><span class="p">,</span><span class="w">
            </span><span class="s2">"close"</span><span class="p">:</span><span class="mf">12.918053</span><span class="p">,</span><span class="w">
            </span><span class="s2">"amount"</span><span class="p">:</span><span class="mf">1131.801675005825</span><span class="p">,</span><span class="w">
            </span><span class="s2">"vol"</span><span class="p">:</span><span class="mf">14506.9381937385</span><span class="p">,</span><span class="w">
            </span><span class="s2">"count"</span><span class="p">:</span><span class="mi">923</span><span class="p">,</span><span class="w">
            </span><span class="s2">"bid"</span><span class="p">:</span><span class="mf">12.912687</span><span class="p">,</span><span class="w">
            </span><span class="s2">"bidSize"</span><span class="p">:</span><span class="mf">0.1068</span><span class="p">,</span><span class="w">
