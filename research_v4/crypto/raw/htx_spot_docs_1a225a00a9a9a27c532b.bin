<th>Field</th>
<th>Data Type</th>
<th>Required</th>
<th>Description</th>
</tr>
</thead><tbody>
<tr>
<td>code</td>
<td>integer</td>
<td>TRUE</td>
<td>Status code</td>
</tr>
<tr>
<td>message</td>
<td>string</td>
<td>FALSE</td>
<td>Error message (if any)</td>
</tr>
<tr>
