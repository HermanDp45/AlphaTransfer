                    </span><span class="s2">"amount"</span><span class="p">:</span><span class="w"> </span><span class="mf">1.24E-4</span><span class="p">,</span><span class="w">
                    </span><span class="s2">"price"</span><span class="p">:</span><span class="w"> </span><span class="mf">49656.4</span><span class="p">,</span><span class="w">
                    </span><span class="s2">"direction"</span><span class="p">:</span><span class="w"> </span><span class="s2">"buy"</span><span class="w">
                </span><span class="p">}</span><span class="w">
            </span><span class="p">]</span><span class="w">
        </span><span class="p">},</span><span class="w">
        </span><span class="p">{</span><span class="w">
            </span><span class="s2">"id"</span><span class="p">:</span><span class="w"> </span><span class="mi">136108763320</span><span class="p">,</span><span class="w">
            </span><span class="s2">"ts"</span><span class="p">:</span><span class="w"> </span><span class="mi">1629793656198</span><span class="p">,</span><span class="w">
            </span><span class="s2">"data"</span><span class="p">:</span><span class="w"> </span><span class="p">[</span><span class="w">
                </span><span class="p">{</span><span class="w">
                    </span><span class="s2">"id"</span><span class="p">:</span><span class="w"> </span><span class="mi">136108763320348400439066863</span><span class="p">,</span><span class="w">
                    </span><span class="s2">"ts"</span><span class="p">:</span><span class="w"> </span><span class="mi">1629793656198</span><span class="p">,</span><span class="w">
                    </span><span class="s2">"trade-id"</span><span class="p">:</span><span class="w"> </span><span class="mi">102517381181</span><span class="p">,</span><span class="w">
                    </span><span class="s2">"amount"</span><span class="p">:</span><span class="w"> </span><span class="mf">0.01125</span><span class="p">,</span><span class="w">
                    </span><span class="s2">"price"</span><span class="p">:</span><span class="w"> </span><span class="mf">49655.0</span><span class="p">,</span><span class="w">
