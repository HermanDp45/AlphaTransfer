<table><thead>
<tr>
<th>Field</th>
<th>Data Type</th>
<th>Description</th>
</tr>
</thead><tbody>
<tr>
<td>&lt;data&gt;</td>
<td>true</td>
<td>object</td>
</tr>
<tr>
<td>id</td>
<td>true</td>
<td>int</td>
</tr>
<tr>
<td>type</td>
<td>true</td>
<td>string</td>
</tr>
<tr>
