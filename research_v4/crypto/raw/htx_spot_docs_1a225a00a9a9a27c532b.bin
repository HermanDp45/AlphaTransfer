<table><thead>
<tr>
<th>Parameter</th>
<th>Data Type</th>
<th>Required</th>
<th>Default</th>
<th>Description</th>
</tr>
</thead><tbody>
<tr>
<td>clientOrderId</td>
<td>string</td>
<td>true</td>
<td>NA</td>
<td>Client order ID</td>
</tr>
</tbody></table>

