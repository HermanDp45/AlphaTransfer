                </span><span class="s2">"price"</span><span class="p">:</span><span class="w"> </span><span class="mf">49806.0</span><span class="p">,</span><span class="w">
                </span><span class="s2">"direction"</span><span class="p">:</span><span class="w"> </span><span class="s2">"buy"</span><span class="w">
            </span><span class="p">},</span><span class="w">
            </span><span class="p">{</span><span class="w">
                </span><span class="s2">"id"</span><span class="p">:</span><span class="w"> </span><span class="mi">136107843051348400229813302</span><span class="p">,</span><span class="w">
                </span><span class="s2">"ts"</span><span class="p">:</span><span class="w"> </span><span class="mi">1629792191928</span><span class="p">,</span><span class="w">
                </span><span class="s2">"trade-id"</span><span class="p">:</span><span class="w"> </span><span class="mi">102517374387</span><span class="p">,</span><span class="w">
