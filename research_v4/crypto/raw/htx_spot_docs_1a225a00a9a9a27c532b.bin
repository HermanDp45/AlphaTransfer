        </span><span class="s2">"high"</span><span class="p">:</span><span class="mf">52924.14</span><span class="p">,</span><span class="w">
        </span><span class="s2">"open"</span><span class="p">:</span><span class="mf">51823.62</span><span class="p">,</span><span class="w">
        </span><span class="s2">"close"</span><span class="p">:</span><span class="mf">52379.99</span><span class="p">,</span><span class="w">
        </span><span class="s2">"vol"</span><span class="p">:</span><span class="mf">727676440.200527</span><span class="p">,</span><span class="w">
